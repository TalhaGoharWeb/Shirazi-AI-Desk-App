rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Check if user is accessing their own resource
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Helper function: Check for Super Admin (muhaqqiqcreates@gmail.com)
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'muhaqqiqcreates@gmail.com' ||
        request.auth.token.role == 'super_admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    // Helper function: Role-based admin check
    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.token.role in ['admin', 'super_admin'] ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
        )
      );
    }

    // 1. User Profiles Collection
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // Legacy scholar profile mapping (backward compatibility)
    match /scholars/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // 2. Multi-User Conversations Collection
    match /conversations/{conversationId} {
      // Users can ONLY read their own conversations; Super Admin & Admin can inspect all
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || isAdmin()
      );
      
      // Conversations must be created with ownerUid matching the authenticated user
      allow create: if isAuthenticated() && (
        request.resource.data.ownerUid == request.auth.uid
      );
      
      // Updates and deletions restricted to owner or Super Admin / Admin
      allow update: if isAuthenticated() && (
        (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid) || isAdmin()
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || isAdmin()
      );

      // Subcollection: Messages inside a conversation
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerUid == request.auth.uid || isAdmin()
        );
        
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerUid == request.auth.uid
        );
        
        allow update, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerUid == request.auth.uid || isAdmin()
        );
      }
    }

    // 3. Centralized Admin Collections (Telemetry, Moderation, Global Audit)
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
