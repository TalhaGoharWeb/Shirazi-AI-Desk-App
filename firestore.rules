rules_version = '2';

// Shirazi AI Desk — Firestore Security Rules (production hardening).
//
// AUTHORIZATION MODEL (§2, §3, §12, §13):
// - Privileged roles come ONLY from Firebase Authentication custom claims,
//   assigned server-side via the Admin SDK (tools/set_super_admin_claim.mjs).
// - NEVER trust users/{uid}.role or any other client-writable document for
//   authorization. A previous version of these rules did, which allowed any
//   user to grant themselves admin/super_admin.
// - Users may write only whitelisted, non-privileged fields on their own
//   profile document. `role`, `isAdmin`, `admin`, `superAdmin` and similar
//   fields are rejected on every client write.
// - Every conversation / message / inquiry document carries ownerUid and is
//   readable/writable only by its owner (or a claims-verified admin).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── Server-controlled custom claims ONLY ──────────────────────────
    // Set via Firebase Admin SDK; clients cannot mint or modify these.
    function claimRole() {
      return isAuthenticated() && request.auth.token.role != null
        ? request.auth.token.role
        : '';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        claimRole() == 'super_admin' || request.auth.token.superAdmin == true
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (isAuthenticated() && (
        claimRole() == 'admin' || request.auth.token.admin == true
      ));
    }

    // ── Profile field whitelist ───────────────────────────────────────
    // Fields a user may set on their OWN profile. Privilege-related fields
    // are never writable by clients — not on create, not on update.
    function allowedProfileFields() {
      // NOTE: `role` / `isAdmin` / privilege flags are deliberately ABSENT —
      // clients must never write them (see noPrivilegeFields()). Privileges
      // come only from server-side custom claims.
      return [
        'displayName', 'scholarName', 'photoURL', 'language', 'madhhab',
        'scholarlyRank', 'persona', 'theme', 'notifications', 'email',
        'uid', 'isAnonymous', 'honorCodeAccepted', 'isnadVerified',
        'createdAt', 'updatedAt', 'lastLogin'
      ];
    }

    function noPrivilegeFields() {
      return !(
        'role' in request.resource.data ||
        'isAdmin' in request.resource.data ||
        'admin' in request.resource.data ||
        'superAdmin' in request.resource.data ||
        'super_admin' in request.resource.data
      );
    }

    function validProfileWrite() {
      return request.resource.data.keys().hasOnly(allowedProfileFields())
        && noPrivilegeFields();
    }

    // Update variant: only the *changed* fields must be whitelisted.
    // A document written by an older client may still carry a legacy
    // privilege field (e.g. `role`); it may persist untouched, but no
    // client can add or modify one — any such change lands in
    // affectedKeys() and is rejected, since privilege fields are absent
    // from allowedProfileFields().
    function validProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(allowedProfileFields());
    }

    // 1. User Profiles — owner-writable for whitelisted fields only.
    //    Admins (claims-verified) may read any profile; only the super admin
    //    may update/delete profiles or touch privilege state (via claims,
    //    never via document fields).
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && validProfileWrite();
      allow update: if (isOwner(uid) && validProfileUpdate()) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Private per-user vault (BYOK API keys, etc.) — OWNER ONLY.
      // Not even claims-verified admins can read these documents, so a
      // user's personal provider keys are never visible to anyone else.
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Legacy scholar profile mapping (backward compatibility)
    match /scholars/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && validProfileWrite();
      allow update: if (isOwner(uid) && validProfileUpdate()) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      match /{allSubcollections=**} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) || isSuperAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // 2. Conversations — strict per-user isolation (§12).
    //    ownerUid is immutable after create and must equal the caller's uid.
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || isAdmin()
      );

      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && noPrivilegeFields();

      allow update: if isAuthenticated() && (
        (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && noPrivilegeFields()
        ) || isAdmin()
      );

      allow delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || isAdmin()
      );

      match /messages/{messageId} {
        function parentOwned() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerUid == request.auth.uid;
        }
        allow read: if isAuthenticated() && (parentOwned() || isAdmin());
        allow create: if isAuthenticated() && parentOwned()
          && noPrivilegeFields();
        allow update, delete: if isAuthenticated() && (parentOwned() || isAdmin());
      }
    }

    // 3. Research inquiries — same isolation as conversations.
    match /inquiries/{inquiryId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && noPrivilegeFields();
      allow update: if isAuthenticated() && (
        (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && noPrivilegeFields()
        ) || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || isAdmin()
      );
    }

    // 4. Centralized admin collections — claims-verified admins only (§13).
    //    Never reachable with a client-set role field.
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // 5. Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
